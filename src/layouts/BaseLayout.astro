---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Party experiences and event talent." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body class="app-layout">
    <SiteHeader class="app-layout-header" />
    <div class="app-layout-content no-scrollbar">
      <slot />
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .app-layout {
    display: grid;
    grid-template-rows: max-content 1fr;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
  .app-layout-header {
    position: relative;
    z-index: 1;
  }
  .app-layout-content {
    width: 100%;
    min-height: 0;
    overflow: auto;
  }
</style>
