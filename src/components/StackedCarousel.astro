---
import { withBase } from "../utils/paths";

interface CarouselItem {
  src: string;
  alt: string;
}

interface Props {
  items: readonly CarouselItem[];
  label?: string;
  initialIndex?: number;
  autoplayMs?: number;
}

const {
  items,
  label = "Featured photos",
  initialIndex = 2,
  autoplayMs = 4000,
} = Astro.props;

const activeIndex =
  items.length > 0
    ? ((initialIndex % items.length) + items.length) % items.length
    : -1;

const positionByOffset = new Map([
  [-2, "outer-left"],
  [-1, "inner-left"],
  [0, "center"],
  [1, "inner-right"],
  [2, "outer-right"],
]);

function getPosition(index: number) {
  let offset = (index - activeIndex + items.length) % items.length;

  if (offset > items.length / 2) {
    offset -= items.length;
  }

  return positionByOffset.get(offset) ?? "hidden";
}
---

<div
  class="stacked-carousel"
  data-stacked-carousel
  data-active-index={activeIndex}
  data-autoplay-ms={autoplayMs}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
>
  {
    items.map((item, index) => {
      const position = getPosition(index);
      const isActive = index === activeIndex;

      return (
        <button
          class:list={[
            "stacked-carousel__card",
            `is-${position}`,
            { "is-active": isActive },
          ]}
          type="button"
          data-carousel-card
          aria-label={`Select image ${index + 1} of ${items.length}`}
          aria-pressed={isActive}
          tabindex={position === "hidden" ? -1 : 0}
        >
          <img
            src={withBase(item.src)}
            alt={item.alt}
            draggable="false"
          />
        </button>
      );
    })
  }

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status>
    {activeIndex >= 0
      ? `Image ${activeIndex + 1} of ${items.length} selected`
      : "No images available"}
  </p>
</div>

<script>
  const positionClasses = [
    "is-outer-left",
    "is-inner-left",
    "is-center",
    "is-inner-right",
    "is-outer-right",
    "is-hidden",
  ];

  const positionByOffset: Record<number, string> = {
    [-2]: "is-outer-left",
    [-1]: "is-inner-left",
    0: "is-center",
    1: "is-inner-right",
    2: "is-outer-right",
  };

  document.querySelectorAll<HTMLElement>("[data-stacked-carousel]").forEach((carousel) => {
    const cards = Array.from(
      carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-card]"),
    );
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    const autoplayMs = Number(carousel.dataset.autoplayMs) || 0;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    let activeIndex = Number(carousel.dataset.activeIndex);
    let autoplayId: number | undefined;

    if (cards.length === 0) {
      return;
    }

    if (!Number.isInteger(activeIndex) || activeIndex < 0) {
      activeIndex = cards.length > 2 ? 2 : 0;
    }

    function applyStack() {
      cards.forEach((card, index) => {
        let offset = (index - activeIndex + cards.length) % cards.length;

        if (offset > cards.length / 2) {
          offset -= cards.length;
        }

        const positionClass = positionByOffset[offset] ?? "is-hidden";
        const isActive = offset === 0;

        card.classList.remove(...positionClasses, "is-active");
        card.classList.add(positionClass);
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-pressed", String(isActive));
        card.tabIndex = positionClass === "is-hidden" ? -1 : 0;
      });

      carousel.dataset.activeIndex = String(activeIndex);

      if (status) {
        status.textContent = `Image ${activeIndex + 1} of ${cards.length} selected`;
      }
    }

    function goTo(index: number) {
      activeIndex = ((index % cards.length) + cards.length) % cards.length;
      applyStack();
    }

    function restartAutoplay() {
      window.clearInterval(autoplayId);

      if (autoplayMs > 0 && cards.length > 1 && !prefersReducedMotion.matches) {
        autoplayId = window.setInterval(() => {
          goTo(activeIndex + 1);
        }, autoplayMs);
      }
    }

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        goTo(index);
        restartAutoplay();
      });
    });

    carousel.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") {
        return;
      }

      event.preventDefault();
      goTo(activeIndex + (event.key === "ArrowRight" ? 1 : -1));
      cards[activeIndex]?.focus();
      restartAutoplay();
    });

    prefersReducedMotion.addEventListener("change", restartAutoplay);

    applyStack();
    restartAutoplay();
  });
</script>

<style>
  .stacked-carousel {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 386px;
    touch-action: pan-y;
  }

  .stacked-carousel__card {
    position: absolute;
    margin: 0;
    padding: 0;
    overflow: hidden;
    appearance: none;
    background: transparent;
    border: 4.5px solid #fff;
    border-radius: 8px;
    box-shadow: 0 3px 13px rgb(0 0 0 / 15%);
    cursor: pointer;
    transition:
      left 450ms ease,
      top 450ms ease,
      width 450ms ease,
      height 450ms ease,
      border-width 450ms ease,
      opacity 250ms ease;
  }

  .stacked-carousel__card:focus-visible {
    outline: 3px solid #e92d6e;
    outline-offset: 3px;
  }

  .stacked-carousel__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
  }

  .stacked-carousel__card.is-active {
    cursor: default;
  }

  .stacked-carousel__card.is-outer-left {
    left: 0;
    top: 26.4%;
    z-index: 1;
    width: 21.6%;
    height: 64%;
  }

  .stacked-carousel__card.is-inner-left {
    left: 12%;
    top: 19.9%;
    z-index: 3;
    width: 28.6%;
    height: 74.6%;
  }

  .stacked-carousel__card.is-center {
    left: 32%;
    top: 0;
    z-index: 5;
    width: 35.8%;
    height: 100%;
    border-width: 6px;
  }

  .stacked-carousel__card.is-inner-right {
    left: 62.1%;
    top: 19.9%;
    z-index: 3;
    width: 28.6%;
    height: 74.6%;
  }

  .stacked-carousel__card.is-outer-right {
    left: 78.3%;
    top: 26.4%;
    z-index: 1;
    width: 21.7%;
    height: 64%;
  }

  .stacked-carousel__card.is-hidden {
    top: 50%;
    z-index: 0;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .stacked-carousel {
      height: clamp(220px, 56vw, 320px);
      margin-top: 14px;
    }

    .stacked-carousel__card.is-outer-left,
    .stacked-carousel__card.is-outer-right {
      opacity: 0;
      pointer-events: none;
    }

    .stacked-carousel__card.is-inner-left {
      left: 0;
      top: 18%;
      width: 39%;
      height: 72%;
    }

    .stacked-carousel__card.is-center {
      left: 20%;
      width: 60%;
      height: 100%;
    }

    .stacked-carousel__card.is-inner-right {
      left: 61%;
      top: 18%;
      width: 39%;
      height: 72%;
    }
  }

  @media (max-width: 600px) {
    .stacked-carousel {
      height: clamp(190px, 60vw, 250px);
    }

    .stacked-carousel__card {
      border-width: 3px;
    }

    .stacked-carousel__card.is-inner-left {
      left: -4%;
      width: 42%;
    }

    .stacked-carousel__card.is-center {
      left: 16%;
      width: 68%;
      border-width: 4px;
    }

    .stacked-carousel__card.is-inner-right {
      left: 62%;
      width: 42%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stacked-carousel__card {
      transition: none;
    }
  }
</style>
