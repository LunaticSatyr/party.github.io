---
import { withBase } from "../utils/paths";

const linkGroups = [
  {
    title: "Platform",
    links: [
      { label: "How it works", href: "/how-it-works" },
      { label: "Work With Us", href: "/contact-us" },
      { label: "Pricing", href: "/contact-us" },
      { label: "FAQs", href: "/faqs" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "/about" },
      { label: "Blogs", href: "/" },
      { label: "Contact", href: "/contact-us" },
      { label: "Careers", href: "/contact-us" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy" },
      { label: "Terms and Conditions", href: "/terms-and-conditions" },
      { label: "Cookie Policy", href: "/privacy-policy#cookies" },
    ],
  },
];
---

<footer class="site-footer" data-site-footer>
  <div class="container">
    <div class="site-footer__top">
      <section class="site-footer__newsletter" aria-labelledby="newsletter-title">
        <h2 id="newsletter-title">Exclusive Talent. Exceptional Nights.</h2>
        <p>Get exclusive access to our newest talent and event inspiration.</p>
        <form data-newsletter-form>
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            placeholder="Enter your email for perks"
            autocomplete="email"
            required
          />
          <button type="submit">Subscribe</button>
        </form>
        <p class="site-footer__form-status" aria-live="polite" data-newsletter-status></p>
      </section>

      <nav class="site-footer__links" aria-label="Footer navigation">
        {
          linkGroups.map((group, groupIndex) => (
            <div class="site-footer__group">
              <button
                type="button"
                aria-expanded="true"
                aria-controls={`footer-links-${groupIndex}`}
                data-footer-toggle
              >
                {group.title}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m7 10 5 5 5-5"></path>
                </svg>
              </button>
              <ul id={`footer-links-${groupIndex}`} data-footer-list>
                {group.links.map((link) => (
                  <li><a href={withBase(link.href)}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>© 2026 PartiStaff. All rights reserved.</p>
      <div class="site-footer__socials">
        <a href="https://www.facebook.com/partistaff" aria-label="PartiStaff on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="site-footer__facebook" d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v6h4v-6h3l1-4h-4V9c0-.6.4-1 1-1Z"></path>
          </svg>
        </a>
        <a href="https://www.instagram.com/partistaff/" aria-label="PartiStaff on Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" class="site-footer__icon-dot"></circle>
          </svg>
        </a>
      </div>
    </div>

    <div class="site-footer__logo">
      <img src={withBase("/brand/footer-logo.svg")} alt="PartiStaff — Our People, Your Place" />
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLElement>("[data-site-footer]").forEach((footer) => {
    const toggles = Array.from(
      footer.querySelectorAll<HTMLButtonElement>("[data-footer-toggle]"),
    );
    const lists = Array.from(footer.querySelectorAll<HTMLElement>("[data-footer-list]"));
    const mobileQuery = window.matchMedia("(max-width: 768px)");
    const form = footer.querySelector<HTMLFormElement>("[data-newsletter-form]");
    const status = footer.querySelector<HTMLElement>("[data-newsletter-status]");

    function syncFooter() {
      toggles.forEach((toggle, index) => {
        const expanded = !mobileQuery.matches;
        toggle.setAttribute("aria-expanded", String(expanded));
        lists[index].hidden = !expanded;
      });
    }

    toggles.forEach((toggle, index) => {
      toggle.addEventListener("click", () => {
        if (!mobileQuery.matches) return;
        const expanded = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!expanded));
        lists[index].hidden = expanded;
      });
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (status) status.textContent = "Thanks — you’re on the list.";
      form.reset();
    });

    mobileQuery.addEventListener("change", syncFooter);
    syncFooter();
  });
</script>

<style>
  .site-footer {
    color: #ffffff;
    background: #000000;
  }

  .site-footer__top {
    display: flex;
    padding: 4rem 0 2.75rem;
    gap: 5rem;
  }

  .site-footer__newsletter {
    width: min(40%, 32.5rem);
    flex: 0 0 auto;
  }

  .site-footer__newsletter h2 {
    font-family: var(--font-cursive);
    font-size: clamp(3rem, 4.2vw, 3.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .site-footer__newsletter > p:not(.site-footer__form-status) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  form {
    display: flex;
    margin-top: 1.5rem;
    gap: 0.75rem;
  }

  input {
    min-width: 0;
    height: 2.75rem;
    padding-inline: 0.875rem;
    flex: 1;
    color: #ffffff;
    background: rgb(255 255 255 / 10%);
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: var(--radius-md);
    outline: none;
  }

  input::placeholder {
    color: rgb(255 255 255 / 42%);
  }

  input:focus {
    border-color: #ffffff;
  }

  form button {
    height: 2.75rem;
    padding-inline: 1.35rem;
    color: #000000;
    font-size: 1rem;
    font-weight: 500;
    background: #ffffff;
    border: 0;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  form button:hover {
    color: #ffffff;
    background: var(--color-accent-dark);
  }

  .site-footer__form-status {
    min-height: 1.25rem;
    margin-top: 0.5rem;
    color: #f6a1bb;
    font-size: 0.8rem;
  }

  .site-footer__links {
    display: flex;
    padding-top: 0.25rem;
    flex: 1;
    justify-content: space-between;
    gap: 3.5rem;
  }

  .site-footer__group button {
    display: flex;
    width: 100%;
    padding: 0;
    align-items: center;
    justify-content: space-between;
    color: #ffffff;
    font-weight: 600;
    background: transparent;
    border: 0;
    cursor: default;
  }

  .site-footer__group button svg {
    display: none;
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 180ms ease;
  }

  .site-footer__group ul {
    display: flex;
    padding: 0;
    margin: 1.25rem 0 0;
    flex-direction: column;
    gap: 0.8rem;
    list-style: none;
  }

  .site-footer__group a {
    color: #848484;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .site-footer__group a:hover {
    color: #ffffff;
  }

  .site-footer__bottom {
    display: flex;
    padding-block: 1.25rem;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 10%);
  }

  .site-footer__bottom > p {
    color: rgb(255 255 255 / 56%);
    font-size: 0.875rem;
  }

  .site-footer__socials {
    display: flex;
    gap: 0.8rem;
  }

  .site-footer__socials a {
    display: grid;
    width: 1.875rem;
    height: 1.875rem;
    place-items: center;
    color: rgb(255 255 255 / 58%);
  }

  .site-footer__socials a:hover {
    color: #ffffff;
  }

  .site-footer__socials svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .site-footer__facebook,
  .site-footer__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .site-footer__logo {
    padding-bottom: 2.5rem;
  }

  .site-footer__logo img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .site-footer__top {
      flex-direction: column;
      gap: 3rem;
    }

    .site-footer__newsletter {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .site-footer__top {
      padding-block: 2rem 1.5rem;
      gap: 1.75rem;
    }

    .site-footer__links {
      flex-direction: column;
      gap: 0;
    }

    .site-footer__group {
      padding-block: 0.6rem;
      border-bottom: 1px solid rgb(255 255 255 / 10%);
    }

    .site-footer__group button {
      cursor: pointer;
    }

    .site-footer__group button svg {
      display: block;
    }

    .site-footer__group button[aria-expanded="true"] svg {
      transform: rotate(180deg);
    }

    .site-footer__group ul {
      padding-block: 0.5rem;
      margin-top: 0.75rem;
    }

    .site-footer__group ul[hidden] {
      display: none;
    }

    .site-footer__logo {
      padding-bottom: 1.25rem;
    }
  }

  @media (max-width: 520px) {
    form {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem;
    }

    form button {
      padding-inline: 1rem;
    }

    .site-footer__bottom {
      align-items: flex-start;
      gap: 1rem;
    }

    .site-footer__bottom > p {
      font-size: 0.75rem;
    }
  }
</style>
