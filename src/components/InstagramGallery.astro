---
import { withBase } from "../utils/paths";

interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: readonly GalleryImage[];
}

const { images } = Astro.props;
---

<section class="instagram" data-instagram-gallery>
  <div class="container">
    <header class="instagram__heading">
      <h2>Follow us on Instagram</h2>
      <a href="https://www.instagram.com/partistaff/" aria-label="PartiStaff on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" class="instagram__icon-dot"></circle>
        </svg>
        @partistaff
      </a>
    </header>

    <div class="instagram__grid scroll-container" data-instagram-track>
      {
        images.map((image, index) => (
          <figure class:list={{ "instagram__large": index === 0 }}>
            <img src={withBase(image.src)} alt={image.alt} loading="lazy" />
          </figure>
        ))
      }
    </div>

    <div class="instagram__dots" aria-label="Choose an Instagram image">
      {
        images.map((_, index) => (
          <button
            class:list={["instagram__dot", { "is-active": index === 0 }]}
            type="button"
            aria-label={`Show Instagram image ${index + 1}`}
            aria-pressed={index === 0}
            data-instagram-dot
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-instagram-gallery]").forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>("[data-instagram-track]");
    const cells = Array.from(track?.children ?? []) as HTMLElement[];
    const dots = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("[data-instagram-dot]"),
    );
    let frameId: number | undefined;

    function setActive(index: number) {
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === index;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-pressed", String(active));
      });
    }

    track?.addEventListener("scroll", () => {
      window.cancelAnimationFrame(frameId);
      frameId = window.requestAnimationFrame(() => {
        if (!track) return;
        const index = cells.reduce((closest, cell, cellIndex) => {
          const currentDistance = Math.abs(cell.offsetLeft - track.scrollLeft);
          const closestDistance = Math.abs(cells[closest].offsetLeft - track.scrollLeft);
          return currentDistance < closestDistance ? cellIndex : closest;
        }, 0);
        setActive(index);
      });
    }, { passive: true });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        cells[index]?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
      });
    });
  });
</script>

<style>
  .instagram {
    padding-block: var(--space-section);
    background: #ffffff;
  }

  .instagram__heading {
    margin-bottom: 1.75rem;
    text-align: center;
  }

  .instagram__heading h2 {
    font-family: var(--font-cursive);
    font-size: clamp(3.75rem, 5vw, 4.25rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .instagram__heading a {
    display: inline-flex;
    margin-top: 0.4rem;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
  }

  .instagram__heading svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .instagram__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .instagram__grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    height: 35rem;
    gap: 1.25rem;
  }

  figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .instagram__large {
    grid-row: 1 / 3;
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  figure:hover img {
    transform: scale(1.04);
  }

  .instagram__dots {
    display: none;
  }

  @media (max-width: 1024px) {
    .instagram__grid {
      height: 27.5rem;
      gap: 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .instagram__grid {
      display: grid;
      height: auto;
      grid-template: none;
      grid-auto-flow: column;
      grid-auto-columns: calc(50% - 0.375rem);
      gap: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }

    .instagram__grid::-webkit-scrollbar {
      display: none;
    }

    figure,
    .instagram__large {
      height: clamp(15rem, 48vw, 22rem);
      grid-row: auto;
      scroll-snap-align: start;
    }

    .instagram__dots {
      display: flex;
      margin-top: 1rem;
      justify-content: center;
      gap: 0.45rem;
    }

    .instagram__dot {
      width: 0.45rem;
      height: 0.45rem;
      padding: 0;
      background: #d1d1d1;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
    }

    .instagram__dot.is-active {
      background: var(--color-accent);
    }
  }

  @media (max-width: 600px) {
    .instagram__grid {
      grid-auto-columns: 100%;
    }

    figure,
    .instagram__large {
      height: clamp(18rem, 88vw, 24rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    figure img {
      transition: none;
    }
  }
</style>
