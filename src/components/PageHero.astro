---
import { withBase } from "../utils/paths";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
  compact?: boolean;
}

const {
  title,
  description,
  eyebrow,
  image,
  imageAlt = "",
  compact = false,
} = Astro.props;
---

<header class:list={["page-hero", { "page-hero--image": image, "page-hero--compact": compact }]}> 
  {image && <img src={withBase(image)} alt={imageAlt} width="1600" height="1067" />}
  {image && <div class="page-hero__shade"></div>}
  <div class="container page-hero__content">
    {eyebrow && <p>{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <span>{description}</span>}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    display: grid;
    min-height: 25rem;
    place-items: center;
    overflow: hidden;
    color: var(--color-text);
    text-align: center;
    background: #f7f7f7;
  }

  .page-hero--compact {
    min-height: 20rem;
  }

  .page-hero--image {
    min-height: clamp(28rem, 52vw, 39rem);
    place-items: end start;
    color: #ffffff;
    text-align: left;
    background: #111111;
  }

  .page-hero > img,
  .page-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero > img {
    object-fit: cover;
  }

  .page-hero__shade {
    background:
      linear-gradient(90deg, rgb(0 0 0 / 76%), rgb(0 0 0 / 18%) 72%),
      linear-gradient(0deg, rgb(0 0 0 / 48%), transparent 56%);
  }

  .page-hero__content {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .page-hero__content p {
    margin-bottom: 0.75rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .page-hero--image .page-hero__content p {
    color: #f6a1bb;
  }

  h1 {
    max-width: 60rem;
    margin-inline: auto;
    font-family: var(--font-cursive);
    font-size: clamp(4.5rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  .page-hero--image h1 {
    margin-inline: 0;
  }

  .page-hero__content > span {
    display: block;
    max-width: 45rem;
    margin: 1rem auto 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
  }

  .page-hero--image .page-hero__content > span {
    margin-inline: 0;
    color: rgb(255 255 255 / 86%);
  }

  @media (max-width: 600px) {
    .page-hero,
    .page-hero--compact {
      min-height: 19rem;
    }

    .page-hero--image {
      min-height: 29rem;
    }

    h1 {
      font-size: 4.5rem;
    }
  }
</style>
