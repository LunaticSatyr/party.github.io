---
interface Props {
  title: string;
  image: string;
  alt: string;
  cta: string;
  href?: string;
  color: string;
  imagePosition?: string;
}

const {
  title,
  image,
  alt,
  cta,
  href = "/contact-us",
  color,
  imagePosition = "center",
} = Astro.props;
---

<article
  class="service-card"
  style={`--service-color: ${color}; --service-position: ${imagePosition};`}
>
  <img src={image} alt={alt} loading="lazy" />
  <div class="service-card__overlay"></div>
  <div class="service-card__content">
    <h3>{title}</h3>
    <a href={href}>
      {cta}
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="m12 5 5 5-5 5M3 10h14"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    min-height: 12.25rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  .service-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--service-position);
    transition: transform 400ms ease;
  }

  .service-card:hover > img {
    transform: scale(1.04);
  }

  .service-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--service-color) 0%, color-mix(in srgb, var(--service-color) 72%, transparent) 40%, transparent 82%);
  }

  .service-card__content {
    position: relative;
    display: flex;
    min-height: 12.25rem;
    padding: 2.5rem 1.5rem 1.5rem;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
  }

  h3 {
    color: #ffffff;
    font-family: var(--font-cursive);
    font-size: clamp(3rem, 4.8vw, 4.35rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: 0;
  }

  a {
    display: inline-flex;
    min-height: 2.25rem;
    padding-inline: 0.875rem;
    align-items: center;
    gap: 0.35rem;
    color: #171717;
    font-size: 0.875rem;
    font-weight: 500;
    background: #ffffff;
    border-radius: var(--radius-md);
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  a svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  a:hover {
    color: #ffffff;
    background: var(--color-accent-dark);
  }

  @media (max-width: 600px) {
    .service-card,
    .service-card__content {
      min-height: 11.75rem;
    }

    h3 {
      font-size: 3.75rem;
    }
  }
</style>
