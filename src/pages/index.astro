  {
    quote:
      "Marisa was friendly, proactive, and experienced. She helped the whole event feel effortless from the first guest to the final song.",
    name: "Marco Rossi",
    role: "Club Owner, Ibiza",
    avatar: "/images/events/event-03.jpg",
  },
  {
    quote:
      "The quality of staff we find through PartiStaff is consistently excellent. It has become our go-to for every private event.",
    name: "James Walker",
    role: "Event Director, London",
    avatar: "/images/events/event-11.jpg",
  },
  {
    quote:
      "Our host read the room perfectly and kept everything moving without ever making the night feel overly managed.",
    name: "Sofia Martin",
