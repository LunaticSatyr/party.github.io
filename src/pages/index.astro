  },
] as const;

const instagramImages = [
  { src: "/images/events/event-07.jpg", alt: "A summer yacht party" },
  { src: "/images/events/event-09.jpg", alt: "An elegant event venue" },
  { src: "/images/events/event-08.jpg", alt: "A DJ behind the decks" },
  { src: "/images/events/event-10.jpg", alt: "Guests making a toast" },
  { src: "/images/events/event-11.jpg", alt: "A lively private event" },
