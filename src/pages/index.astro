---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main>
    <HomeHero items={heroItems} />
    <BrandMarquee />

    <section class="services" id="services">
      <div class="container">
        <header class="section-heading">
          <h2>Let’s Make It Happen</h2>
          <p>Choose the experience. We’ll match you with the right people.</p>
        </header>

        <div class="services__grid">
          {
            services.map((service) => (
              <ServiceCard {...service} href="/contact-us" />
            ))
          }
        </div>
      </div>
    </section>

    <LocationGallery locations={locations} />
    <HowItWorks steps={howItWorks} />
    <Testimonials testimonials={testimonials} />
    <InstagramGallery images={instagramImages} />
    <ClosingCta
      image="/images/events/event-03.jpg"
      alt="Friends celebrating together at a private event"
    />
    <BrandMarquee />
  </main>

  <style>
    .services {
      padding-block: var(--space-section);
      background: #ffffff;
    }

    .services__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    @media (max-width: 1024px) {
      .services__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 768px) {
      .services__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
